# GitHub Linguist. Works for the language bar only once "Tulpar" exists in Linguist (see linguist/SUBMIT.md);
# until then GitHub ignores the unknown name and does not count .tlp files.
*.tlp linguist-language=Tulpar
*.tlp linguist-detectable=true
# files that should not affect statistics
linguist/** linguist-documentation
bench/*.c linguist-vendored
bench/*.rs linguist-vendored
bench/*.py linguist-vendored
tests/**/*.out linguist-generated

# Классикалық алгоритмдер: нәтижелері белгілі
анықта ферзьдер(n: бүтін, қатар: бүтін, бағ: тізім[логика], d1: тізім[логика], d2: тізім[логика]) -> бүтін:
    егер қатар == n:
        қайтар 1
    саны = 0
    әр с ішінде аралық(n):
        егер бағ[с] немесе d1[қатар + с] немесе d2[қатар - с + n - 1]:
            жалғастыр
        бағ[с] = рас
        d1[қатар + с] = рас
        d2[қатар - с + n - 1] = рас
        саны += ферзьдер(n, қатар + 1, бағ, d1, d2)
        бағ[с] = жалған
        d1[қатар + с] = жалған
        d2[қатар - с + n - 1] = жалған
    қайтар саны

анықта ферзь_саны(n: бүтін) -> бүтін:
    қайтар ферзьдер(n, 0, [жалған] * n, [жалған] * (2 * n), [жалған] * (2 * n))

тексер ферзь_саны(6) == 4
тексер ферзь_саны(8) == 92
жаз("8 ферзь:", ферзь_саны(8))

анықта тез_сұрыпта(а: тізім[бүтін], төмен: бүтін, жоғары: бүтін):
    егер төмен >= жоғары:
        қайтар
    тірек = а[(төмен + жоғары) // 2]
    і = төмен
    j = жоғары
    әзірше і <= j:
        әзірше а[і] < тірек:
            і += 1
        әзірше а[j] > тірек:
            j -= 1
        егер і <= j:
            а[і], а[j] = а[j], а[і]
            і += 1
            j -= 1
    тез_сұрыпта(а, төмен, j)
    тез_сұрыпта(а, і, жоғары)

тұқым(7)
ж = [кездейсоқ_аралық(0, 1000000) әр _к ішінде аралық(200000)]
к = ж.көшірме()
тез_сұрыпта(ж, 0, ұзындық(ж) - 1)
к.сұрыпта()
тексер ж == к
жаз("сұрыптау сәтті:", ұзындық(ж), ж[0] <= ж[1])

анықта екілік_іздеу(а: тізім[бүтін], x: бүтін) -> бүтін:
    төмен = 0
    жоғары = ұзындық(а) - 1
    әзірше төмен <= жоғары:
        орта = (төмен + жоғары) // 2
        егер а[орта] == x:
            қайтар орта
        әйтпесе егер а[орта] < x:
            төмен = орта + 1
        әйтпесе:
            жоғары = орта - 1
    қайтар -1

сандар = [x * 3 әр x ішінде аралық(1000)]
тексер екілік_іздеу(сандар, 2997) == 999
тексер екілік_іздеу(сандар, 2998) == -1
тексер екілік_іздеу(сандар, 0) == 0
жаз("екілік іздеу сәтті")

анықта жай_сандар(n: бүтін) -> бүтін:
    ел = [рас] * (n + 1)
    ел[0] = жалған
    ел[1] = жалған
    і = 2
    әзірше і * і <= n:
        егер ел[і]:
            әр j ішінде аралық(і * і, n + 1, і):
                ел[j] = жалған
        і += 1
    c = 0
    әр v ішінде ел:
        егер v:
            c += 1
    қайтар c
тексер жай_сандар(1000000) == 78498
жаз("жай сандар < 10^6:", жай_сандар(1000000))

анықта нод(a: бүтін, b: бүтін) -> бүтін:
    әзірше b != 0:
        a, b = b, a % b
    қайтар a
тексер нод(48, 18) == 6
тексер нод(17, 5) == 1

анықта матрица_көбейт(a: тізім[тізім[нақты]], b: тізім[тізім[нақты]], n: бүтін) -> тізім[тізім[нақты]]:
    нәтиже: тізім[тізім[нақты]] = []
    әр і ішінде аралық(n):
        қатар = [0.0] * n
        әр j ішінде аралық(n):
            s = 0.0
            әр k ішінде аралық(n):
                s += a[і][k] * b[k][j]
            қатар[j] = s
        нәтиже.қос(қатар)
    қайтар нәтиже

n = 60
A = [[нақты(і + j) әр j ішінде аралық(n)] әр і ішінде аралық(n)]
I = [[1.0 егер і == j әйтпесе 0.0 әр j ішінде аралық(n)] әр і ішінде аралық(n)]
R = матрица_көбейт(A, I, n)
тексер R == A
жаз("матрица сәтті, мүше:", R[10][20])

анықта хаос(n: бүтін) -> бүтін:
    h = 5381
    әр і ішінде аралық(n):
        h = (h * 33 + і) % 1000000007
    қайтар h
жаз(хаос(1000000))
жаз("дайын")

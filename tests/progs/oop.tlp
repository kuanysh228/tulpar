# Деректер құрылымдары: стек, кезек, екілік іздеу ағашы, байланысты тізім, калькулятор
класс Түйін:
    мән: бүтін
    сол: Түйін
    оң: Түйін

класс Ағаш:
    түбір: Түйін
    өлшем: бүтін = 0

    анықта қос(өзі, мән: бүтін):
        өзі.түбір = өзі._қос(өзі.түбір, мән)

    анықта _қос(өзі, т: Түйін, мән: бүтін) -> Түйін:
        егер т == жоқ:
            өзі.өлшем += 1
            қайтар Түйін(мән, жоқ, жоқ)
        егер мән < т.мән:
            т.сол = өзі._қос(т.сол, мән)
        әйтпесе егер мән > т.мән:
            т.оң = өзі._қос(т.оң, мән)
        қайтар т

    анықта бар_ма(өзі, мән: бүтін) -> логика:
        т = өзі.түбір
        әзірше т != жоқ:
            егер мән == т.мән:
                қайтар рас
            т = т.сол егер мән < т.мән әйтпесе т.оң
        қайтар жалған

    анықта тереңдік(өзі, т: Түйін) -> бүтін:
        егер т == жоқ:
            қайтар 0
        қайтар 1 + мақс2(өзі.тереңдік(т.сол), өзі.тереңдік(т.оң))

    анықта ретімен(өзі, т: Түйін, нәтиже: тізім[бүтін]):
        егер т == жоқ:
            қайтар
        өзі.ретімен(т.сол, нәтиже)
        нәтиже.қос(т.мән)
        өзі.ретімен(т.оң, нәтиже)

анықта мақс2(a: бүтін, b: бүтін) -> бүтін:
    қайтар a егер a > b әйтпесе b

а = Ағаш()
әр v ішінде [50, 30, 70, 20, 40, 60, 80, 30, 65]:
    а.қос(v)
нәт: тізім[бүтін] = []
а.ретімен(а.түбір, нәт)
жаз(нәт, а.өлшем, а.тереңдік(а.түбір), а.бар_ма(65), а.бар_ма(66))
тексер нәт == [20, 30, 40, 50, 60, 65, 70, 80]

класс Стек:
    элементтер: тізім[бүтін]
    анықта құру(өзі):
        өзі.элементтер = []
    анықта итер(өзі, x: бүтін):
        өзі.элементтер.қос(x)
    анықта ал(өзі) -> бүтін:
        қайтар өзі.элементтер.ал()
    анықта бос(өзі) -> логика:
        қайтар ұзындық(өзі.элементтер) == 0

# тіркелген калькулятор: RPN
анықта rpn(жол: мәтін) -> бүтін:
    с = Стек()
    әр белгі ішінде жол.бөлу(" "):
        егер белгі == "+":
            b = с.ал()
            a = с.ал()
            с.итер(a + b)
        әйтпесе егер белгі == "*":
            b = с.ал()
            a = с.ал()
            с.итер(a * b)
        әйтпесе егер белгі == "-":
            b = с.ал()
            a = с.ал()
            с.итер(a - b)
        әйтпесе:
            с.итер(бүтін(белгі))
    қайтар с.ал()
жаз(rpn("3 4 + 2 *"), rpn("10 2 8 * + 3 -"))
тексер rpn("3 4 + 2 *") == 14

# рекурсивті түсу парсері: өрнек = мүше (('+'|'-') мүше)*
класс Парсер:
    мәтін1: мәтін
    орын: бүтін = 0

    анықта құру(өзі, м: мәтін):
        өзі.мәтін1 = м

    анықта көр(өзі) -> мәтін:
        әзірше өзі.орын < ұзындық(өзі.мәтін1) және өзі.мәтін1[өзі.орын] == " ":
            өзі.орын += 1
        егер өзі.орын >= ұзындық(өзі.мәтін1):
            қайтар ""
        қайтар өзі.мәтін1[өзі.орын]

    анықта өрнек(өзі) -> нақты:
        мән = өзі.мүше()
        әзірше рас:
            с = өзі.көр()
            егер с == "+":
                өзі.орын += 1
                мән += өзі.мүше()
            әйтпесе егер с == "-":
                өзі.орын += 1
                мән -= өзі.мүше()
            әйтпесе:
                қайтар мән
        қайтар мән

    анықта мүше(өзі) -> нақты:
        мән = өзі.көбейткіш()
        әзірше рас:
            с = өзі.көр()
            егер с == "*":
                өзі.орын += 1
                мән *= өзі.көбейткіш()
            әйтпесе егер с == "/":
                өзі.орын += 1
                мән /= өзі.көбейткіш()
            әйтпесе:
                қайтар мән
        қайтар мән

    анықта көбейткіш(өзі) -> нақты:
        с = өзі.көр()
        егер с == "(":
            өзі.орын += 1
            мән = өзі.өрнек()
            өзі.көр()
            өзі.орын += 1
            қайтар мән
        егер с == "-":
            өзі.орын += 1
            қайтар -өзі.көбейткіш()
        бас = өзі.орын
        әзірше өзі.орын < ұзындық(өзі.мәтін1) және (өзі.мәтін1[өзі.орын] ішінде "0123456789."):
            өзі.орын += 1
        қайтар нақты(өзі.мәтін1[бас:өзі.орын])

анықта есепте(м: мәтін) -> нақты:
    қайтар Парсер(м).өрнек()
жаз(есепте("1 + 2 * 3"), есепте("(1 + 2) * 3"), есепте("10 / 4 - 1"), есепте("-(2 + 3) * 2.5"))
тексер есепте("2 * (3 + 4) - 5") == 9.0

# сөздер жиілігі
мәтін2 = "ол бір екі ол үш бір ол төрт"
жиілік: сөздік[мәтін, бүтін] = {}
әр сөз ішінде мәтін2.бөлу(" "):
    жиілік[сөз] = жиілік.ал(сөз, 0) + 1
жаз(жиілік, жиілік["ол"])
тексер жиілік["ол"] == 3

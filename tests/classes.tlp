класс Нүкте:
    x: нақты
    y: нақты

    анықта ұзындық(өзі) -> нақты:
        қайтар түбір(өзі.x * өзі.x + өзі.y * өзі.y)

    анықта жылжыт(өзі, dx: нақты, dy: нақты):
        өзі.x += dx
        өзі.y += dy

класс Санауыш:
    мән: бүтін = 0
    қадам: бүтін = 1
    аты: мәтін = "санауыш"

    анықта құру(өзі, бастапқы: бүтін = 0):
        өзі.мән = бастапқы

    анықта өсір(өзі) -> бүтін:
        өзі.мән += өзі.қадам
        қайтар өзі.мән

класс Түйін:
    мән: бүтін
    келесі: Түйін = жоқ

p = Нүкте(3.0, 4.0)
жаз(p.ұзындық(), p.x, p)
p.жылжыт(1.0, -1.0)
жаз(p)
q = Нүкте(y=2.0, x=1.0)
жаз(q.x, q.y)
c = Санауыш()
c.өсір()
c.өсір()
жаз(c.мән, c.аты, c)
d = Санауыш(10)
d.қадам = 5
жаз(d.өсір(), d.өсір())
тізбек: Түйін = жоқ
әр і ішінде аралық(5):
    тізбек = Түйін(і, тізбек)
т = тізбек
әзірше т != жоқ:
    көрсет(т.мән, " ")
    т = т.келесі
жаз()
жаз(тізбек.келесі.келесі.мән, тізбек == жоқ, тізбек != жоқ, p == p, p == q)
нүктелер = [Нүкте(1.0, 1.0), Нүкте(2.0, 2.0)]
әр н ішінде нүктелер:
    н.жылжыт(0.5, 0.5)
жаз(нүктелер)
сөздік1 = {"o": Нүкте(0.0, 0.0)}
сөздік1["o"].x = 7.5
жаз(сөздік1)

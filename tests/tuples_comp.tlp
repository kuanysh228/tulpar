анықта бөл_қалдық(a: бүтін, b: бүтін) -> (бүтін, бүтін):
    қайтар a // b, a % b

анықта мин_макс(х: тізім[нақты]) -> (нақты, нақты):
    қайтар мин(х), макс(х)

q, r = бөл_қалдық(17, 5)
жаз(q, r)
т = бөл_қалдық(100, 7)
жаз(т, т[0], т[1], т[-1])
a, b = мин_макс([3.5, -1.0, 8.25])
жаз(a, b)
жұп = (1, "бір", 2.5)
жаз(жұп, жұп[1], (1,))
n, s, f = жұп
жаз(n, s, f)
n, s = n + 4, s + "!"
жаз(n, s)

жұптар = [(1, "а"), (2, "б"), (3, "в")]
әр сан, әріп ішінде жұптар:
    көрсет(сан, әріп, ";")
жаз()
әр і, x ішінде нөмірле([10, 20]):
    көрсет(і, x, ";")
жаз()
жаз((1, 2) == (1, 2), (1, 2) == (1, 3), [1, 2] == [1, 2], [1, 2] == [1, 3], {"a": 1} == {"a": 1}, [[1], [2]] == [[1], [2]], ["a"] == ["a"])
жаз([1, 2] != [1, 2], [1, 2] != [2, 1])

# генераторлар
квадраттар = [x * x әр x ішінде аралық(6)]
жаз(квадраттар)
жұп_сандар = [x әр x ішінде аралық(20) егер x % 2 == 0 және x > 10]
жаз(жұп_сандар)
сөздер = ["алма", "алмұрт", "өрік"]
ұзындықтар = [ұзындық(w) әр w ішінде сөздер]
жаз(ұзындықтар, [w.үлкен() әр w ішінде сөздер], [c әр c ішінде "әбв"])
жаз([(i, i * i) әр i ішінде аралық(3)])
жаз([x * 2.5 әр x ішінде [1, 2]], [[j әр j ішінде аралық(i)] әр i ішінде аралық(4)])
жаз(қосынды([x әр x ішінде аралық(101)]), қосынды([0.5, 0.25]), мин([4, 2, 9]), макс([4.5, 2.0]))
x = 77
жаз([x әр x ішінде аралық(3)], x)
cp = [1, 2, 3]
cp2 = cp.көшірме()
cp2.қос(4)
жаз(cp, cp2, cp.индекс(3), cp.индекс(9))
cp.кірістір(0, 100)
cp.кірістір(2, 200)
cp.кірістір(99, 300)
жаз(cp, cp.өшір(0), cp.өшір(-1), cp)

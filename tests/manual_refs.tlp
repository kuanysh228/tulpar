# GC-сілтемелері қолмен жадта: GC оларды жоймауы керек
класс Қорап:
    мән: бүтін

қолмен:
    мәтіндер = бөл(мәтін, 4)
    қораптар = бөл(Қорап, 4)
    әр і ішінде аралық(4):
        мәтіндер[і] = "жол-" + мәтін(і * 1000)
        қораптар[і] = Қорап(і * 7)
    жина()
    # көп қоқыс жасап GC-ні қайта-қайта іске қосу
    әр к ішінде аралық(200000):
        z = "қоқыс" + мәтін(к)
    жина()
    әр і ішінде аралық(4):
        көрсет(мәтіндер[і], қораптар[і].мән, ";")
    жаз()
    босат(мәтіндер)
    босат(қораптар)
    # қайта бөлу нөлденген блок береді
    q = бөл(мәтін, 4)
    жаз(q[0] == жоқ, q[3] == жоқ)
    босат(q)

анықта екі_есе(x: бүтін) -> бүтін:
    қайтар x * 2

анықта қолдан(f: (бүтін) -> бүтін, x: бүтін) -> бүтін:
    қайтар f(f(x))

анықта қосу(a: бүтін, b: бүтін) -> бүтін:
    қайтар a + b

f: (бүтін) -> бүтін = екі_есе
жаз(f(5), қолдан(екі_есе, 3), қолдан(лямбда x: x + 100, 1))
g: (бүтін, бүтін) -> бүтін = қосу
жаз(g(2, 3))
h: (нақты) -> нақты = лямбда t: t * 0.5
жаз(h(5.0))
амалдар: тізім[(бүтін, бүтін) -> бүтін] = [қосу, лямбда a, b: a * b, лямбда a, b: a - b]
әр ам ішінде амалдар:
    көрсет(ам(7, 3), " ")
жаз()

класс Батырма:
    аты: мәтін
    басу: (мәтін) -> мәтін

б = Батырма("ОК", лямбда s: "басылды: " + s)
жаз(б.басу(б.аты))

сөздер = ["алмұрт", "өрік", "алма", "жүзім"]
сөздер.сұрыпта(лямбда w: ұзындық(w))
жаз(сөздер)
сөздер.сұрыпта(лямбда w: w)
жаз(сөздер)
сандар = [5, -3, 8, -1, 0]
сандар.сұрыпта(лямбда x: абс(x))
жаз(сандар)
сандар.сұрыпта(лямбда x: -x)
жаз(сандар)
нақтылар = [2.5, 0.5, 1.5]
нақтылар.сұрыпта(лямбда x: -x)
жаз(нақтылар)
жұптар = [(3, "в"), (1, "а"), (2, "б")]
жұптар.сұрыпта(лямбда p: p[0])
жаз(жұптар)
анықта кілт_ұзын(s: мәтін) -> бүтін:
    қайтар -ұзындық(s)
сөздер.сұрыпта(кілт_ұзын)
жаз(сөздер)
аралас: (бүтін) -> логика = лямбда n: n % 2 == 0
жаз([аралас(i) әр i ішінде аралық(4)])

анықта қосу(a: бүтін, b: бүтін = 10) -> бүтін:
    қайтар a + b

анықта сәлем(аты: мәтін, леп: мәтін = "!"):
    жаз("Сәлем, " + аты + леп)

анықта факт(n: бүтін) -> бүтін:
    егер n <= 1:
        қайтар 1
    қайтар n * факт(n - 1)

анықта жұп_па(n: бүтін) -> логика:
    қайтар n % 2 == 0

анықта инфер(a: бүтін):
    қайтар a * 2

анықта орташа(х: тізім[нақты]) -> нақты:
    s = 0.0
    әр v ішінде х:
        s += v
    қайтар s / ұзындық(х)

санауыш = 0
анықта арттыр():
    глобал санауыш
    санауыш += 1

анықта оқу_ғана() -> бүтін:
    қайтар санауыш * 100

анықта локал():
    санауыш = 999
    қайтар санауыш

анықта мақсат(n: бүтін, шарт: логика) -> мәтін:
    егер шарт:
        қайтар "иә" * n
    әйтпесе:
        қайтар "жоқ"

жаз(қосу(1, 2), қосу(5), қосу(b=1, a=2))
сәлем("Дәурен")
сәлем("Айгүл", леп="?")
жаз(факт(10), факт(20), жұп_па(4), жұп_па(5))
жаз(инфер(21))
жаз(орташа([1.0, 2.0, 6.0]))
арттыр()
арттыр()
жаз(санауыш, оқу_ғана(), локал(), санауыш)
жаз(мақсат(2, рас), мақсат(2, жалған))
анықта тізім_өзгерт(l: тізім[бүтін]):
    l.қос(42)
t = [1]
тізім_өзгерт(t)
тізім_өзгерт(t)
жаз(t)
анықта көп(a: бүтін, b: бүтін, c: бүтін, d: бүтін, e: бүтін, f: бүтін, g: бүтін, h: бүтін) -> бүтін:
    қайтар a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h
жаз(көп(1, 2, 3, 4, 5, 6, 7, 8))
анықта аралас(a: бүтін, x: нақты, b: бүтін, y: нақты) -> нақты:
    қайтар a * x + b * y
жаз(аралас(2, 1.5, 3, 0.5))

a = [3, 1, 2]
a.қос(5)
a.қос(4)
жаз(a, ұзындық(a), a[0], a[-1], a[1:3], a[:2], a[2:], a[-2:])
жаз(a.ал(), a, a.ал(), a)
a.сұрыпта()
жаз(a)
a.кері()
жаз(a)
жаз(a + [9, 9], [0] * 3, 2 * [1, 2], 3 ішінде a, 7 ішінде a, 7 емес ішінде a)
a[0] = 100
a[-1] = -1
жаз(a)
a[1] += 10
a[2] *= 3
жаз(a)
s = ["б", "а", "в"]
s.сұрыпта()
жаз(s)
f = [2.5, -1.0, 3.25]
f.сұрыпта()
жаз(f, 3.25 ішінде f)
n: тізім[тізім[бүтін]] = []
әр і ішінде аралық(3):
    n.қос([і, і * і])
жаз(n, n[2][1])
n[1][0] = 99
жаз(n)
б = [рас, жалған, рас]
б.қос(жалған)
жаз(б, б[1], ұзындық(б), рас ішінде б)
б[1] = рас
жаз(б)
байттар = [байт(1), байт(200), байт(255)]
жаз(байттар, байттар[2])
бос: тізім[бүтін] = []
жаз(бос, ұзындық(бос), емес бос)
әр x ішінде [10, 20, 30]:
    көрсет(x, ";")
жаз()
жаз(бос + [1])
үлкен = [0] * 1000000
әр к ішінде аралық(1000000):
    үлкен[к] = к
жаз(үлкен[999999], ұзындық(үлкен))


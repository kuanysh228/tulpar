класс Жануар:
    аты: мәтін
    жас: бүтін = 1

    анықта құру(өзі, аты: мәтін):
        өзі.аты = аты

    анықта дыбыс(өзі) -> мәтін:
        қайтар "..."

    анықта таныстыр(өзі) -> мәтін:
        қайтар өзі.аты + " дейді: " + өзі.дыбыс()

класс Ит(Жануар):
    сүйек: бүтін = 0

    анықта дыбыс(өзі) -> мәтін:
        қайтар "Әу-әу!"

    анықта сүйек_көр(өзі):
        өзі.сүйек += 1

класс Мысық(Жануар):
    анықта құру(өзі, аты: мәтін, түсі: мәтін):
        Жануар.құру(өзі, аты)
        өзі.түс = түсі

    түс: мәтін

    анықта дыбыс(өзі) -> мәтін:
        қайтар "Мияу!"

класс Күшік(Ит):
    анықта дыбыс(өзі) -> мәтін:
        қайтар "Ыңыс " + Ит.дыбыс(өзі)

үй: тізім[Жануар] = [Ит("Ақбөрі"), Мысық("Мырза", "сұр"), Жануар("Белгісіз"), Күшік("Кішкентай")]
әр ж ішінде үй:
    жаз(ж.таныстыр())

д = Ит("Тарлан")
д.сүйек_көр()
д.сүйек_көр()
жаз(д.сүйек, д.жас, д.аты, д)
ж: Жануар = д
жаз(мысал(ж, Ит), мысал(ж, Мысық), мысал(ж, Жануар), мысал(үй[3], Ит), мысал(үй[3], Күшік))
ит2 = түрлендір(ж, Ит)
ит2.сүйек_көр()
жаз(ит2.сүйек, ж == д, ж == үй[0])
жаз(үй)
жаз(Мысық("Барсик", "ақ"))
жаз([Ит("а"), Күшік("б")][1].дыбыс())

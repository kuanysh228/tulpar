d = {"бір": 1, "екі": 2}
d["үш"] = 3
d["бір"] = 11
жаз(d, ұзындық(d), d["екі"], "үш" ішінде d, "төрт" ішінде d, "төрт" емес ішінде d)
жаз(d.ал("жоқ", -1), d.ал("бір", -1))
d.жой("екі")
d.жой("жоқ_кілт")
жаз(d, ұзындық(d), d.кілттер(), d.мәндер())
әр к ішінде d:
    көрсет(к, " ")
жаз()
әр к, м ішінде d:
    көрсет(к, "=", м, " ")
жаз()
сан: сөздік[бүтін, мәтін] = {}
әр і ішінде аралық(1000):
    сан[і * 7] = "v" + мәтін(і)
жаз(ұзындық(сан), сан[7 * 500], сан[0], сан[6993])
әр і ішінде аралық(0, 1000, 2):
    сан.жой(і * 7)
жаз(ұзындық(сан), 0 ішінде сан, 7 ішінде сан)
сан[0] = "қайта"
жаз(сан[0], ұзындық(сан))
f = {1: 2.5, 2: 3.5}
f[3] = f[1] + f[2]
жаз(f, f[3])
nested = {"a": [1, 2], "b": [3]}
nested["a"].қос(9)
жаз(nested)
эфир: сөздік[мәтін, сөздік[мәтін, бүтін]] = {}
эфир["x"] = {"y": 1}
эфир["x"]["z"] = 2
жаз(эфир)
счёт: сөздік[мәтін, бүтін] = {}
сөздер = "а б а в б а".бөлу(" ")
әр сөз ішінде сөздер:
    счёт[сөз] = счёт.ал(сөз, 0) + 1
жаз(счёт)

# Ядро режимінде тіл өзгеріссіз жұмыс істейді: мәтін, тізім, сөздік, класс, генератор, GC.
класс Нүкте:
    x: бүтін
    y: бүтін
    анықта ұзындық2(өзі) -> бүтін:
        қайтар өзі.x * өзі.x + өзі.y * өзі.y

жаз("сәлем", 1 + 2, 3.5, рас)
жаз(f"{'абв'.үлкен()} {10 // 3} {7 % 4} {2.0 ** 10.0:.1f}")
a: тізім[бүтін] = [5, 3, 9, 1]
a.сұрыпта()
жаз(a, қосынды(a), макс(a))
д: сөздік[мәтін, бүтін] = {"бір": 1, "екі": 2}
д["үш"] = 3
жаз(ұзындық(д), д["екі"])
жаз(Нүкте(3, 4).ұзындық2())
с = 0
әр і ішінде аралық(200000):
    с += ұзындық(f"тест-{і}")
жаз(с)
жаз(жад() > 0)

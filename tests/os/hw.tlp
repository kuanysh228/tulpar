# Аппараттық ішкі функциялар: CR0, EFER, CPUID, MMIO, mem*, порттар, үзілістер.
таймер_тик = 0

анықта таймер(нөмір: бүтін, код: бүтін):
    глобал таймер_тик
    таймер_тик += 1

қолмен:
    жаз("пейджинг:", (cr_оқы(0) >> 31) & 1, "long mode:", (msr_оқы(0xC0000080) >> 8) & 1)
    жаз("max cpuid бар:", cpuid(0, 0) > 0)

    б = бөл(байт, 16)
    жад_толтыр(б, 7, 16)
    э = мекен(байт, мекенжай(б))
    жаз(э[0], э[15])
    q = бөл(байт, 16)
    жад_көшір(q, б, 16)
    жаз(q[3])
    жаз(оқы8(мекенжай(q) + 5), оқы32(мекенжай(q)))
    жаз32(мекенжай(q) + 4, 0x01020304)
    жаз(q[4], q[5], q[6], q[7], оқы16(мекенжай(q) + 4))
    босат(б)
    босат(q)

    # PIT 0-арнасы 100 Гц, IRQ0 өңдеушісі Tulpar тілінде
    порт_жаз8(0x43, 0x36)
    порт_жаз8(0x40, 11932 % 256)
    порт_жаз8(0x40, 11932 // 256)
    үзіліс_орнату(32, таймер)
    порт_жаз8(0x21, порт_оқы8(0x21) & 0xFE)
    үзіліс_қос()
    t0 = уақыт()
    әзірше таймер_тик < 50:
        тоқтат()
    үзіліс_өшір()
    дт = уақыт() - t0
    жаз("таймер:", дт > 0.4 және дт < 0.7)

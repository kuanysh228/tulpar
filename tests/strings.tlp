с = "Қазақстан Республикасы"
жаз(ұзындық(с), с[0], с[-1], с[3:8], с[:5], с[10:], с[-5:])
жаз(с.үлкен(), "|", с.кіші())
жаз("әіңғүұқөһ".үлкен(), "ӘІҢҒҮҰҚӨҺ".кіші())
жаз(с.тап("Респ"), с.тап("жоқ"), "Республика" ішінде с, "x" емес ішінде с)
жаз(с.бөлу(" "), "a,b,,c".бөлу(","))
жаз("-".біріктір(["бір", "екі", "үш"]), "".біріктір(["a", "b"]))
жаз("  бос орын  ".тазарт() + "|", "abc".басталады("ab"), "abc".аяқталады("bc"), "abc".басталады("bc"))
жаз("aXbXc".ауыстыр("X", "--"), "aaa".ауыстыр("a", "bb"), "abc".ауыстыр("", "z"))
жаз("ab" * 3, 2 * "xyz", "" + "а", "а" + "")
жаз("a" < "b", "abc" < "abd", "" < "a", "Z" < "a", "я" > "а")
жаз("Сәлем" == "Сәлем", "а" != "б")
әр ч ішінде "абв":
    көрсет("[", ч, "]")
жаз()
жаз(f"{1 + 2} {'x' * 2} {с[0]}")
жаз(f"{3.14159:.2f}|{42:5}|{'аб':>6}|{'аб':<6}|{'аб':^6}|{2.5:8.3f}|{7:.1f}")
жаз(f"{{literal}} {рас} {жалған} {[1, 2]} {{}}")
жаз(мәтін(42) + "!", мәтін(3.5), мәтін(рас), мәтін([1, 2]))
a = "тест"
b = a
жаз(a == b, a + b)
жаз("a\tb\\n\"q\"")
ұзын = "абв" * 100000
жаз(ұзындық(ұзын), ұзын[299999])
жаз("é".үлкен(), ұзындық("😀"), "😀x"[1])

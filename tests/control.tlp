әр і ішінде аралық(10):
    егер і % 2 == 0:
        жалғастыр
    егер і > 7:
        тоқта
    көрсет(і, " ")
жаз()
n = 0
әзірше рас:
    n += 1
    егер n >= 5:
        тоқта
жаз(n)
әр а ішінде аралық(3):
    әр б ішінде аралық(3):
        егер б == 2:
            тоқта
        көрсет(а, б, " ")
жаз()
әр і ішінде аралық(5, 0, -2):
    көрсет(і, " ")
жаз()
әр і ішінде аралық(3, 3):
    жаз("ешқашан")
әр і ішінде аралық(-2, 2):
    көрсет(і, " ")
жаз()
x = 15
егер x < 10:
    жаз("кіші")
әйтпесе егер x < 20:
    жаз("орташа")
әйтпесе:
    жаз("үлкен")
егер 0:
    жаз("жоқ")
егер 5:
    жаз("5 рас")
егер "":
    жаз("жоқ")
егер "а":
    жаз("мәтін рас")
бос_тізім: тізім[бүтін] = []
егер бос_тізім:
    жаз("жоқ")
егер [0]:
    жаз("тізім рас")
егер 0.0:
    жаз("жоқ")
егер емес 0.0:
    жаз("0.0 жалған")
a, b, c = 1, 2, 3
a, b, c = c, a, b
жаз(a, b, c)
м = [1, 2, 3]
м[0], м[2] = м[2], м[0]
жаз(м)
k = 0
әр i1 ішінде аралық(5):
    k += i1
жаз(k)
бос = 0
әр і ішінде аралық(бос):
    жаз("ешқашан")

а = {1, 2, 3, 2}
б: жиын[бүтін] = {3, 4}
жаз(а, б, ұзындық(а), 2 ішінде а, 9 ішінде а, 9 емес ішінде а)
жаз(а | б, а & б, а - б, б - а)
а.қос(10)
а.қос(1)
а.жой(2)
а.жой(77)
жаз(а, а.тізім(), а == {1, 3, 10}, а == {1, 3})
бос = жиын[мәтін]()
жаз(бос, ұзындық(бос), емес бос)
сөздер = жиын(["алма", "алма", "өрік", "алмұрт"])
жаз(ұзындық(сөздер), "өрік" ішінде сөздер)
сан = 0
әр w ішінде сөздер:
    сан += ұзындық(w)
жаз(сан)
үлкен: жиын[бүтін] = {}
әр і ішінде аралық(100000):
    үлкен.қос(і % 1000)
жаз(ұзындық(үлкен))
жаз(код("А"), код("a"), код("ә"), таңба(1179), таңба(65), таңба(8364))
жаз("123".сан_ма(), "12a".сан_ма(), "".сан_ма(), "қазақ".әріп_ма(), "ab1".әріп_ма())
жаз("  көп   бос  орын ".бөлу(), "a,b".бөлу(","), "abababa".саны("aba"), "абв".саны(""))
шифр = ""
әр ч ішінде "ABC":
    шифр += таңба(код(ч) + 1)
жаз(шифр)

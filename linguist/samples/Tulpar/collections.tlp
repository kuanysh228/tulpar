сандар = [5, 3, 8, 1]
сандар.қос(10)
сандар.сұрыпта()
жаз(сандар, ұзындық(сандар), сандар[0], сандар[-1])
әр і, x ішінде нөмірле(сандар):
    көрсет(f"{і}:{x} ")
жаз()

сөз = {"бір": 1, "екі": 2}
сөз["үш"] = 3
жаз(сөз, "екі" ішінде сөз, сөз["үш"])
әр к, м ішінде сөз:
    жаз(к, "=>", м)

класс Нүкте:
    x: нақты
    y: нақты

    анықта қашықтық(өзі) -> нақты:
        қайтар түбір(өзі.x * өзі.x + өзі.y * өзі.y)

p = Нүкте(3.0, 4.0)
жаз(p, p.қашықтық())
p.x += 1.0
жаз(f"{p.x:.2f} {p.қашықтық():.3f}")

мәтін1 = "Қазақстан Республикасы"
жаз(мәтін1.үлкен(), мәтін1.кіші(), ұзындық(мәтін1))
бөліктер = мәтін1.бөлу(" ")
жаз(бөліктер, "-".біріктір(бөліктер))
жаз(мәтін1.ауыстыр("а", "@"), мәтін1[0:7])
әр c ішінде "әұғ":
    көрсет(c, ",")
жаз()
жаз([1.5, 2.5], [[1, 2], [3]], {"a": [1, 2]})

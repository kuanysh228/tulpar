# github-linguist/linguist -> lib/linguist/languages.yml ішіне әліпби реті бойынша қосылатын жазба.
# language_id мәнін `script/update-ids` жасайды (қолмен ойлап табуға болмайды).
Tulpar:
  type: programming
  color: "#e8b923"
  extensions:
  - ".tlp"
  tm_scope: source.tulpar
  ace_mode: text
  interpreters: []
  aliases:
  - tlp
  - тұлпар
  language_id: 0  # script/update-ids арқылы толтырылады

# Entry for github-linguist/linguist -> lib/linguist/languages.yml (keep alphabetical order).
# `language_id` is intentionally omitted: `script/update-ids` generates it.
Tulpar:
  type: programming
  color: "#e8b923"
  extensions:
  - ".tlp"
  tm_scope: source.tulpar
  ace_mode: text
  aliases:
  - tlp

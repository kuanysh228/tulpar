# Қолмен жад басқару: бөл / босат, көрсеткіштер тек `қолмен:` блогында
қолмен:
    p = бөл(бүтін, 5)
    әр і ішінде аралық(5):
        p[і] = і * і
    сома = 0
    әр і ішінде аралық(5):
        сома += p[і]
    жаз("квадраттар қосындысы:", сома)
    *p = 100
    жаз(*p, p[1], p[4])
    босат(p)

    б = бөл(байт, 4)
    б[0] = 72
    б[1] = 105
    жаз(б[0], б[1], бүтін(б[0]) + бүтін(б[1]))
    босат(б)

# бөлу-босату циклы жадты қайта қолданады
қолмен:
    әр і ішінде аралық(1000000):
        q = бөл(бүтін, 100)
        q[99] = і
        босат(q)
жаз("дайын, үйінді:", жад() < 50000000)

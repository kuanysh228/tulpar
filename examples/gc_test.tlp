класс Түйін:
    мән: бүтін
    келесі: Түйін

# 1) көп қоқыс: жад өспеуі керек
жалпы = 0
әр і ішінде аралық(3000000):
    с = "жол " + мәтін(і)
    жалпы += ұзындық(с)
жаз("қоқыс жасалды, ұзындықтар қосындысы:", жалпы)

# 2) тірі құрылым GC-ден аман қалуы керек
бас: Түйін = жоқ
әр і ішінде аралық(200000):
    бас = Түйін(і, бас)
    л = [1, 2, 3]
сан = 0
т = бас
әзірше т != жоқ:
    сан += т.мән
    т = т.келесі
жаз("тізім қосындысы:", сан)
жина()
жаз("GC кейінгі жад (байт):", жад() < 100000000)

# 3) үлкен тізімдер
үлкен: тізім[тізім[бүтін]] = []
әр і ішінде аралық(100):
    үлкен.қос([0] * 100000)
жаз(ұзындық(үлкен))

# Екілік ағаш: GC-ді сынау (көп қысқа өмірлі түйіндер)
класс Түйін:
    сол: Түйін
    оң: Түйін

анықта жаса(тереңдік: бүтін) -> Түйін:
    егер тереңдік == 0:
        қайтар Түйін(жоқ, жоқ)
    қайтар Түйін(жаса(тереңдік - 1), жаса(тереңдік - 1))

анықта санау(т: Түйін) -> бүтін:
    егер т.сол == жоқ:
        қайтар 1
    қайтар 1 + санау(т.сол) + санау(т.оң)

ұзақ = жаса(18)
жаз("ұзақ өмірлі ағаш түйіндері:", санау(ұзақ))
жалпы = 0
әр i1 ішінде аралық(40):
    уақытша = жаса(16)
    жалпы += санау(уақытша)
жаз("уақытша ағаштар түйіндері:", жалпы)
жаз("ұзақ ағаш әлі де бүтін:", санау(ұзақ))

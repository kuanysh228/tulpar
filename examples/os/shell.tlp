# Минималды ОЖ қабығы: жол оқиды (COM1 немесе PS/2 пернетақтасы), пәрмендерді орындайды.
# Мәтіндер, тізімдер, сөздіктер және GC ядрода да жұмыс істейді.

жаз("Tulpar OS 0.1  (help — пәрмендер тізімі)")
тарих: тізім[мәтін] = []
басталу = уақыт()

анықта кідіріс(мс: бүтін):
    қолмен:
        соңы = тактілер() + мс * 2000000          # шамамен, 2 ГГц деп
        әзірше тактілер() < соңы:
            өткіз

әзірше рас:
    жол = оқы("tulpar> ").тазарт()
    егер жол == "":
        жалғастыр
    тарих.қос(жол)
    бөліктер = жол.бөлу()
    пәрмен = бөліктер[0]
    егер пәрмен == "help":
        жаз("help  echo  time  mem  gc  history  calc a + b  cpu  halt")
    әйтпесе егер пәрмен == "echo":
        жаз(" ".біріктір(бөліктер[1:]))
    әйтпесе егер пәрмен == "time":
        жаз(f"жұмыс уақыты: {уақыт() - басталу:.2f} с")
    әйтпесе егер пәрмен == "mem":
        жаз(f"үйінді: {жад()} байт")
    әйтпесе егер пәрмен == "gc":
        жина()
        жаз(f"жиналды, үйінді: {жад()} байт")
    әйтпесе егер пәрмен == "history":
        әр і ішінде аралық(ұзындық(тарих)):
            жаз(f"{і + 1}: {тарих[і]}")
    әйтпесе егер пәрмен == "calc" және ұзындық(бөліктер) == 4:
        a = бүтін(бөліктер[1])
        b = бүтін(бөліктер[3])
        оп = бөліктер[2]
        егер оп == "+":
            жаз(a + b)
        әйтпесе егер оп == "-":
            жаз(a - b)
        әйтпесе егер оп == "*":
            жаз(a * b)
        әйтпесе егер оп == "/" және b != 0:
            жаз(a // b)
        әйтпесе:
            жаз("қате амал")
    әйтпесе егер пәрмен == "cpu":
        қолмен:
            # CPUID 0: өндіруші жолы EBX, EDX, ECX регистрлерінде
            ө = ""
            әр р ішінде [1, 3, 2]:
                v = cpuid(0, р)
                әр k ішінде аралық(4):
                    ө += таңба((v >> (8 * k)) & 255)
            жаз("өндіруші:", ө)
    әйтпесе егер пәрмен == "halt":
        жаз("қош болыңыз")
        шығу(0)
    әйтпесе:
        жаз(f"белгісіз пәрмен: {пәрмен}")

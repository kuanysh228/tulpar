# PIT таймері (IRQ0) үзілісі: өңдеуші Tulpar тілінде жазылған.
тиктер = 0

анықта таймер(нөмір: бүтін, код: бүтін):
    глобал тиктер
    тиктер += 1

қолмен:
    # PIT 0-арнасы: 100 Гц (1193182 / 11932)
    порт_жаз8(0x43, 0x36)
    порт_жаз8(0x40, 11932 % 256)
    порт_жаз8(0x40, 11932 // 256)
    үзіліс_орнату(32, таймер)                    # IRQ0 = вектор 32
    порт_жаз8(0x21, порт_оқы8(0x21) & 0xFE)      # PIC: IRQ0-ді қосу
    үзіліс_қос()

    t0 = уақыт()
    әзірше тиктер < 100:
        тоқтат()                                  # hlt: келесі үзіліске дейін ұйқы
    жаз(f"{тиктер} тик, {уақыт() - t0} с (күтілетіні ~1.0)")
    үзіліс_өшір()

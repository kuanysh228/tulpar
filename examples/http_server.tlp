# Қарапайым HTTP сервер: curl http://localhost:8080/
порт = 8080
# тыңда_локал — тек осы компьютерден қолжетімді; барлық желіден қабылдау үшін тыңда(порт) қолданыңыз
сервер = тыңда_локал(порт)
жаз(f"сервер http://localhost:{порт} мекенжайында тыңдап тұр (тоқтату: Ctrl+C)")
саны = 0
әзірше рас:
    клиент = қабылда(сервер)
    егер клиент < 0:
        жалғастыр
    сұраныс = желі_оқы(клиент)
    жолдар = сұраныс.бөлу("\r\n")
    бірінші = жолдар[0] егер ұзындық(жолдар) > 0 әйтпесе ""
    бөліктер = бірінші.бөлу()
    жол = бөліктер[1] егер ұзындық(бөліктер) > 1 әйтпесе "/"
    саны += 1
    жаз(f"{саны}: {бірінші}")
    дене = ""
    егер жол == "/":
        дене = f"<h1>Сәлем, Тұлпар!</h1><p>сұраныс №{саны}</p>"
    әйтпесе егер жол == "/уақыт":
        дене = f"уақыт: {уақыт()}"
    әйтпесе:
        дене = f"табылмады: {жол}"
    статус = "200 OK" егер жол == "/" немесе жол == "/уақыт" әйтпесе "404 Not Found"
    жауап = f"HTTP/1.1 {статус}\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: {дене.байт_саны()}\r\nConnection: close\r\n\r\n{дене}"
    желі_жаз(клиент, жауап)
    желі_жап(клиент)

# HTTP клиент: GET сұраныс жіберіп жауапты басып шығарады
хост = "127.0.0.1"
порт = 8099
с = қосыл(хост, порт)
егер с < 0:
    жаз("қосылу мүмкін емес")
    шығу(1)
желі_жаз(с, f"GET /сәлем HTTP/1.1\r\nHost: {хост}\r\nConnection: close\r\n\r\n")
жауап = ""
әзірше рас:
    бөлік = желі_оқы(с)
    егер бөлік == "":
        тоқта
    жауап += бөлік
желі_жап(с)
жаз(жауап)

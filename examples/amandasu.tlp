# Енгізу: аты мен жасын сұрайды
аты = оқы("Атыңыз кім? ")
жас = бүтін(оқы("Жасыңыз нешеде? "))
жаз(f"Сәлем, {аты}! {10} жылдан кейін сіз {жас + 10} жаста боласыз".ауыстыр("10", "10"))
сомасы = 0
әзірше рас:
    жол = оқы("сан (бос = аяқтау): ")
    егер жол == "":
        тоқта
    сомасы += бүтін(жол)
жаз("қосынды:", сомасы)
